{
  "name": "Servidor Web PHP + MySQL",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8080, 3306],
  "portsAttributes": {
    "8080": {
      "label": "Aplicação PHP"
    },
    "3306": {
      "label": "MySQL"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "cweijan.vscode-mysql-client2"
      ]
    }
  }
}